# WheelsOnRent - Backend Environment Configuration Template
# Copy this file to .env and fill in the values for EC2 deployment

# Flask Configuration
SECRET_KEY=your_secure_random_secret_jwt_key
FLASK_ENV=production
FRONTEND_URL=http://your-ec2-public-ip-or-domain:3000

# Database Configuration
MONGO_URI=mongodb+srv://user:pass@cluster.mongodb.net/WheelsOnRent?retryWrites=true&w=majority

# Redis (For Caching - Optional but recommended for production)
REDIS_URL=redis://localhost:6379

# Email Service (Resend)
RESEND_APIKEY=re_your_api_key

# AWS Infrastructure (S3 & OCR)
S3_BUCKET_NAME=your-bucket-name
AWS_ACCESS_KEY_ID=your_access_key
AWS_SECRET_ACCESS_KEY=your_secret_key
AWS_REGION=ap-south-1
